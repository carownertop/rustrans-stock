[Unit]
Description=RTL stock: copy GitHub snapshot to sslip.io after inventory CI

[Timer]
# 15 мин после сборки CI (10:10…19:10 МСК), чтобы main уже успел обновиться
OnCalendar=*-*-* 10:25:00
OnCalendar=*-*-* 12:25:00
OnCalendar=*-*-* 14:25:00
OnCalendar=*-*-* 16:25:00
OnCalendar=*-*-* 18:25:00
OnCalendar=*-*-* 19:25:00
Persistent=true

[Install]
WantedBy=timers.target
